{
  "name": "Daily News Digest",
  "active": true,
  "nodes": [
    {"name": "Every Morning", "type": "n8n-nodes-base.scheduleTrigger", "position": [0, 0],
     "parameters": {"rule": {"interval": [{"field": "days"}]}}},
    {"name": "Fetch Headlines", "type": "n8n-nodes-base.httpRequest", "position": [200, 0],
     "notes": "Pulls the top stories from a public news API.",
     "parameters": {"url": "https://example.com/api/top-stories", "method": "GET", "apiKey": "demo-not-a-real-key"}},
    {"name": "Any Stories?", "type": "n8n-nodes-base.if", "position": [400, 0], "parameters": {}},
    {"name": "Send To Slack", "type": "n8n-nodes-base.slack", "position": [600, -100],
     "parameters": {"channel": "#news", "text": "={{ $json.summary }}"},
     "credentials": {"slackApi": {"id": "1", "name": "My Slack"}}},
    {"name": "Log Empty Day", "type": "n8n-nodes-base.set", "position": [600, 100], "parameters": {"mode": "manual"}},
    {"name": "Old Email Step", "type": "n8n-nodes-base.emailSend", "position": [800, 0], "disabled": true, "parameters": {}},
    {"name": "Forgotten Note", "type": "n8n-nodes-base.noOp", "position": [800, 200], "parameters": {}}
  ],
  "connections": {
    "Every Morning": {"main": [[{"node": "Fetch Headlines", "type": "main", "index": 0}]]},
    "Fetch Headlines": {"main": [[{"node": "Any Stories?", "type": "main", "index": 0}]]},
    "Any Stories?": {"main": [
      [{"node": "Send To Slack", "type": "main", "index": 0}],
      [{"node": "Log Empty Day", "type": "main", "index": 0}]]},
    "Send To Slack": {"main": [[{"node": "Old Email Step", "type": "main", "index": 0}]]}
  }
}
